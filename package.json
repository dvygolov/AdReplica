{
  "name": "adreplica",
  "version": "070926b6",
  "private": true,
  "description": "Browser-side Facebook Ads Manager export, import, clone, and bookmarklet loader tooling.",
  "scripts": {
    "bump:build": "node scripts/bump-build-version.cjs",
    "build:payload": "node scripts/build-payload.cjs",
    "check:payload": "node scripts/build-payload.cjs --check",
    "check": "npm run lint && npm test && npm run check:payload && node --check adreplica-og-packager.js && node --check adreplica.js && node --check adreplica-loader.js",
    "prebuild": "npm run bump:build",
    "build": "npm run build:payload && node adreplica-og-packager.js --base-url=https://adreplica.pages.dev/adreplica",
    "deploy": "npx wrangler pages deploy ./dist --project-name=adreplica --branch=main --commit-dirty=true",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write src tests eslint.config.mjs"
  },
  "keywords": [
    "facebook-ads",
    "ads-manager",
    "bookmarklet",
    "campaign-clone"
  ],
  "author": "Yellow Web",
  "license": "UNLICENSED",
  "devDependencies": {
    "acorn": "^8.18.0",
    "esbuild": "^0.25.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6"
  }
}
